# .devcontainer/.env.example
# Copy this file to .env and fill in the keys for the providers you want.
# Keys that are set (non-empty) are automatically included in the LiteLLM
# config at startup. Keys that are absent or empty are ignored — no YAML
# editing required.
#
# Usage:
#   cp .devcontainer/.env.example .devcontainer/.env
#   # edit .env, then:
#   docker compose -f .devcontainer/docker-compose.yml up -d

# ---------------------------------------------------------------------------
# LiteLLM proxy settings
# ---------------------------------------------------------------------------
LITELLM_PORT=4000
LITELLM_MASTER_KEY=sk-devcontainer   # change this to a real secret in production
OLLAMA_MODEL=qwen2.5-coder:7b

# ---------------------------------------------------------------------------
# OpenAI — set to enable gpt-4o, gpt-4o-mini
# ---------------------------------------------------------------------------
# OPENAI_API_KEY=sk-...

# ---------------------------------------------------------------------------
# Anthropic — set to enable claude-sonnet, claude-haiku
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...

# ---------------------------------------------------------------------------
# AWS Bedrock — set all three to enable bedrock-claude-* models
# ---------------------------------------------------------------------------
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_DEFAULT_REGION=eu-west-2
